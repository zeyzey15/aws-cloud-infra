# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Exclude Terraform plan output
*.tfplan

# Sensitive variable files (optional: depending on your usage)
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Ignore backups
*.backup

# Ignore lock files (optional: if you don't want to commit them)
.terraform.lock.hcl
